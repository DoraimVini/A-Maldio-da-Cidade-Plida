  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65f89f6f775333543928e50e4ad7c8b8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: FavelaAmarela.Runtime::FavelaAmarela.Runtime.Quests.FragmentoDeYhtill
  indice: 0
  nomeDoFragmento: "Di\xE1rio de Lady Seraphel"
  caixaDeTexto: {fileID: 1901118518}
  texto: "Acordei no deserto sem lembrar como cheguei. Somos quatro: eu, Morthis,
    Vaine e Aldaron. A rainha ficou no Santu\xE1rio \u2014 diz que n\xE3o pode partir.\n\nO
    deserto cheira a cinzas. E h\xE1 uma melodia no vento que eu conhe\xE7o de antes
    de ter nascido. Escrevo os versos antes que me escapem:\n\n\"Ao longo da costa
    as ondas de nuvem se quebram,\nOs s\xF3is g\xEAmeos afundam por tr\xE1s do lago,\nAs
    sombras se alongam\nEm Carcosa.\"\n\u2014 Lady Seraphel, nobreza de Yhtill"
