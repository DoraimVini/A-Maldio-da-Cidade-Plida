  m_Script: {fileID: 11500000, guid: 65f89f6f775333543928e50e4ad7c8b8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: FavelaAmarela.Runtime::FavelaAmarela.Runtime.Quests.FragmentoDeYhtill
  indice: 1
  nomeDoFragmento: "Anota\xE7\xF5es de Lord Morthis"
  caixaDeTexto: {fileID: 378349712}
  texto: "Perdemos Seraphel na entrada. N\xE3o estava morta \u2014 simplesmente n\xE3o
    estava mais. A geometria deste lugar engole quem n\xE3o presta aten\xE7\xE3o.\n\nOs
    seres daqui s\xE3o cegos e ca\xE7am pelo som. Aprendi a andar devagar. O sil\xEAncio
    \xE9 a \xFAnica moeda que vale aqui \u2014 e ainda assim a m\xFAsica n\xE3o para
    dentro da minha cabe\xE7a:\n\n\"Estranha \xE9 a noite em que as estrelas negras
    sobem,\nE estranhas luas circulam pelos c\xE9us...\"\n\u2014 Lord Morthis de
    Yhtill"
